{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build-static.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'no dependencies: three, suncalc and meshoptimizer are vendored'",
  "framework": null,
  "headers": [
    {
      "source": "/(vendor|assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
